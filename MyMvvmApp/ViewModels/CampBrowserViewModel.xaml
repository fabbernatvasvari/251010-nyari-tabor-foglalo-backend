<Window x:Class = "MyMvvmApp.MainWindow"
        xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d = "http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc = "http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local = "clr-namespace:MyMvvmApp"
        xmlns:viewmodel = "clr-namespace:MyMvvmApp.ViewModels"
        xmlns:vm = "clr-namespace:MyMvvmApp.ViewModels"
        xmlns:model = "clr-namespace:MyMvvmApp.Models"
        xmlns:views = "clr-namespace:MyMvvmApp.Views"
        mc:Ignorable = "d"
        Title = "Nyári Tábor Foglaló desktop" Height = "900" Width = "1600" >
    <Window.DataContext >
        <viewmodel:MainViewModel />
    </Window.DataContext >
    <Window.Resources >
        <!--Ensure that CampsBrowserViewModel exists in MyMvvmApp.ViewModels namespace and is public -->
        <DataTemplate DataType="{x:Type viewmodel:CampsBrowserViewModel}" >
            <views:CampsBrowser />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodel:CampCUDViewModel}" >
            <views:CampCUD />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodel:ControlPanelViewModel}" >
            <views:ControlPanelView />
        </DataTemplate>
    </Window.Resources>
    <!-- ... rest of your code... -->
</Window>     