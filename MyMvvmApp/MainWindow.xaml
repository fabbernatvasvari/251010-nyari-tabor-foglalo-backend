<Window x:Class="MyMvvmApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:viewmodel="clr-namespace:MyMvvmApp.ViewModels"
        xmlns:local="clr-namespace:MyMvvmApp"
        mc:Ignorable="d"
        Title="Nyári Tábor Foglaló desktop" Height="800" Width="1200">
	<Window.DataContext>
		<viewmodel:MainViewModel />
	</Window.DataContext>
	<StackPanel Margin="10">
		<Label>Táborok</Label>
		<ListView ItemsSource="{Binding Classes}"
                  SelectedItem="{Binding SelectedClass, Mode=TwoWay}">
			<ListView.View>
				<GridView>
					<GridViewColumn Header="Kezdés" DisplayMemberBinding="{Binding Name}" />
					<GridViewColumn Header="Befejezés" DisplayMemberBinding="{Binding StudentCount}" />
				</GridView>
			</ListView.View>
		</ListView>
		<Button Content="Törlés"
                Command="{Binding DeleteSelectedCommand}"
                Margin="0,10,0,0" />
	<Grid>
		<TextBlock Text="{Binding Message}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="20"/>
	</Grid>
	</StackPanel>
</Window>
