<Window x:Class="MyMvvmApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:viewmodel="clr-namespace:MyMvvmApp.ViewModels"
        xmlns:local="clr-namespace:MyMvvmApp"
        mc:Ignorable="d"
        Title="Nyári Tábor Foglaló desktop" Height="800" Width="1200">
	<Window.DataContext>
		<viewmodel:MainViewModel />
	</Window.DataContext>
	<Window.Resources>
		<!--<DataTemplate DataType="{x:Type viewmodel:ControlPanelViewModel}">
			<view:ControlPanelView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type viewmodel:StudentViewModel}">
			<view:StudentView />
		</DataTemplate>-->
	</Window.Resources>
	<StackPanel Margin="10">
		<Grid>
			<Menu>
				<MenuItem Header="_File">
					<MenuItem Header="_New" />
					<MenuItem Header="_Open" />
					<Separator />
					<MenuItem Header="_Exit" />
				</MenuItem>
				<MenuItem Header="_Edit">
					<MenuItem Header="_Cut" />
					<MenuItem Header="_Copy" />
					<MenuItem Header="_Paste" />
				</MenuItem>
			</Menu>
			<TextBlock Text="{Binding Message}"
					   VerticalAlignment="Center"
					   HorizontalAlignment="Center"
					   FontSize="20"/>
		</Grid>
		<DockPanel>
			<Menu>
				<MenuItem Header="Főmenüpont">
					<MenuItem Header="Vezérlőpult" />
					<MenuItem Header="Diákok" />
					<MenuItem Header="Vezérlőpult" Command="{Binding ShowControlPanalViewCommand}"></MenuItem>
					<MenuItem Header="Diákok" Command="{Binding ShowStudentViewCommand}" ></MenuItem>
					<MenuItem Header="Osztályok" />
				</MenuItem>
			</Menu>
		</DockPanel>
		<ContentControl Content="{Binding CurrentView}" />
		<Label>Táborok</Label>
		<ListView ItemsSource="{Binding Camps}"
                  SelectedItem="{Binding SelectedCamp, Mode=TwoWay}">
			<ListView.View>
				<GridView>
					<GridViewColumn Header="Kezdés" DisplayMemberBinding="{Binding StartDate}" />
					<GridViewColumn Header="Befejezés" DisplayMemberBinding="{Binding StartDate}" />
				</GridView>
			</ListView.View>
		</ListView>
		<Button Content="Létrehozás"
                Command="{Binding DeleteSelectedCommand}"
                Margin="0,10,0,0" />
		<Button Content="Törlés"
                Command="{Binding DeleteSelectedCommand}"
                Margin="0,10,0,0" />
	</StackPanel>
</Window>
